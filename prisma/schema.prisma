// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum Position {GK LB LCB CB RCB RB CDM LDM RDM LCM RCM CM LAM RAM CAM RM LM RW LW ST CF}

model User {
  id Int @id @default(autoincrement())
  username String @unique
  email String @unique
  passwordHash String
  createdAt DateTime @default(now())
  matchLogs MatchLog[]
}

model MatchLog {
  id Int @id @default(autoincrement())
  userID Int
  user User @relation(fields: [userID], references: [id])
  playedAt DateTime @default(now())
  result String
  goalsFor Int
  goalsAgainst Int
  shotsTaken Int
  passesMade Int
  dribbleCount Int
  tackleCount Int
  shotEvents ShotEvent[]
  passEvents PassEvent[]
  tackleEvents TackleEvent[]
  positionSnapshots PositionSnapshot[]
}


model ShotEvent{
  id Int @id @default(autoincrement())
  matchLogID Int
  matchLog MatchLog @relation(fields:[matchLogID], references: [id])
  position Position
  timestamp Int
  positionX Float
  positionY Float
  targetX Float
  targetY Float
  onTarget Boolean
  scored Boolean
}

model PassEvent{
  id Int @id @default(autoincrement())
  matchLogID Int
  matchLog MatchLog @relation(fields:[matchLogID], references: [id])
  position Position
  timestamp Int
  fromX Float
  fromY Float
  toX Float
  toY Float
  completed Boolean
}

model TackleEvent{
  id Int @id @default(autoincrement())
  matchLogID Int
  matchLog MatchLog @relation(fields:[matchLogID], references: [id])
  position Position
  timestamp Int
  positionX Float
  positionY Float
  successful Boolean
}

model PositionSnapshot{
  id Int @id @default(autoincrement())
  matchLogID Int
  matchLog MatchLog @relation(fields:[matchLogID], references: [id])
  position Position
  timestamp Int
  positionX Float
  positionY Float
}